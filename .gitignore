# volatile / durable-private runtime — reconstructible or local-only (§3.2)
/data/
/state/
/config/
/projects/     # managed repo clones — the lead is read-only over these (§3.2)

# python bytecode (tl-top) — build junk
__pycache__/
*.pyc

# git worktrees for per-feature work (CLAUDE.md workflow) — never source
.worktrees/
