#!/usr/bin/env python3
"""tl-top — read-only queue TUI (§3.5 viewer).

Render, never mutate. It reads current state and displays it; every consequence is a
shell-out to the real tl-* command, so the auditable command path — and its refusals — still
own the decision. Killing tl-top at any point (including mid-action) leaves system state
correct: the shelled command ran or it didn't, on its own terms. Stdlib curses only; holds no
authoritative state — every refresh recomputes the queue from tl-state and the files.

THREE VIEWS over one model and one shared cursor (1/2/3, or tab):
  1 inbox     one row per thing waiting on the owner — the default
  2 briefing  that one decision, full-screen, with its context
  3 modal     :commands over the same data, for going straight to a thing
The cursor is (task, qid); each view renders it, so switching re-frames rather than losing
your place.

The model builders (build_fleet_model, build_queue_model) are PURE functions with no curses
calls, so they are testable without a terminal: `tl-top --selftest` asserts them against
fixture state.
"""
import glob
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field


@dataclass
class Row:
    id: str
    kind: str
    project: str
    state: str          # authoritative runtime state, from tl-state (never the log tail)
    waiting_on: str     # the "who needs me" column; "" when working-and-fine
    rank: int           # sort/visual priority; lower = louder (stop conditions on top)
    findings: list = field(default_factory=list)
    # every task runs in its OWN worktree on its own branch (tl-spawn, §3.11) — parallel workers are
    # the normal case, so which checkout and which branch a row IS matters: `g` merges that branch.
    branch: str = ""
    worktree: str = ""
    base: str = ""      # the sha the worktree started from, for "how far ahead is this?"
    # liveness (§3.5): `started` is when the task was dispatched, `active` when its session last
    # wrote. A worker with nothing to show for ten minutes looks identical to a wedged one without
    # these — and once dispatched, a task recedes into the quiet line, so this is all you get.
    started: float = 0.0
    active: float = 0.0
    report: str = ""    # the deliverable itself — what "approve, skip or fix" is ABOUT
    # How a finished task is finished. tl-approve records `approval` (plan) and tl-deliver records
    # `delivered` (change); neither changes tl-state, which keeps reporting `done`. Without reading
    # them the row goes on asking to be approved after you have approved it.
    approval: str = ""
    delivered: str = ""


# Visual/sort priority: lower = louder. Unresolved gate findings are the single most important
# stop (the decision the whole system exists to slow down), so they rank above everything (0).
# working/paused deliberately recede. The exact internal order is pinned by the selftest.
_RANK = {
    "needs-decision": 1,   # a worker is waiting on the owner
    "blocked": 2,          # can't proceed
    "failed": 3,           # worker died — needs a look
    "done": 4,             # deliverable ready — owner should review / deliver / approve
    "paused": 5,
    "working": 6,
}


def _base_state(state):
    return state.split(":", 1)[0]   # "paused:reason" -> "paused"


def rank(state, has_unresolved_findings):
    if has_unresolved_findings:
        return 0
    return _RANK.get(_base_state(state), 7)   # unknown/other sinks to the bottom


def waiting_on(state, n_unresolved):
    """The 'who needs me' column. '' means working-and-fine — nothing needed."""
    if n_unresolved:
        return "%d finding(s)" % n_unresolved
    return {
        "needs-decision": "decision",
        "blocked": "blocked",
        "failed": "failed",
        "done": "review",
        "paused": "paused",
        "working": "",
    }.get(_base_state(state), state)


def read_meta(path):
    """Parse state/<id>.meta (key=value per line). Mirrors tl_meta_get; last value wins."""
    meta = {}
    try:
        with open(path) as f:
            for line in f:
                k, sep, v = line.partition("=")
                if sep:
                    meta[k.strip()] = v.rstrip("\n")
    except OSError:
        pass
    return meta


def read_findings(path):
    """data/<id>/findings.json -> list. Missing or half-written (mid-gate) -> [] (never crash)."""
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def _liveness(r):
    """What a working row says instead of nothing: when its session last wrote. Cooperative signals
    say what a worker is doing; OS activity says whether it is alive at all (§3.5)."""
    if not r.active:
        return "no session output yet"
    return "last output %s ago" % age(time.time() - r.active)


def read_report(path, limit=200):
    """The worker's deliverable, as lines. A `plan` task IS its report — the row that says
    "approve, skip or fix" is asking about this text, so the TUI has to be able to show it."""
    try:
        with open(path) as f:
            return [ln.rstrip("\n") for ln in f.readlines()[:limit]]
    except OSError:
        return []


def _run_detail(r, now=None):
    """What a running worker's row says: how long, and when it last made a sound. Cooperative
    signals say what it is doing; OS activity says whether it is alive at all (§3.5)."""
    now = time.time() if now is None else now
    bits = [age(now - r.started) if r.started else r.state]
    bits.append("last output %s ago" % age(now - r.active) if r.active else "no output yet")
    if _base_state(r.state) != "working":
        bits.insert(0, r.state)
    return " · ".join(bits)


def _mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def age(seconds):
    """Compact elapsed time: 45s, 4m, 2h, 3d. Ages are read at render, never stored."""
    seconds = int(max(0, seconds))
    for div, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= div:
            return "%d%s" % (seconds // div, unit)
    return "%ds" % seconds


def project_name(meta):
    return meta.get("pname") or os.path.basename(meta.get("project", "").rstrip("/")) or "?"


def build_fleet_model(state_dir, data_dir, state_of):
    """Pure: fixture state -> priority-sorted rows. state_of(id)->state word is injected so this
    needs no subprocess/terminal (the curses layer passes the real tl-state shell-out)."""
    rows = []
    for path in sorted(glob.glob(os.path.join(state_dir, "*.meta"))):
        tid = os.path.basename(path)[:-len(".meta")]
        meta = read_meta(path)
        if meta.get("state") == "done":
            continue   # torn down (mirrors tl-watch active_ids) — no longer in the fleet
        rt = state_of(tid)   # authoritative current state (tl-state), never the status-log tail
        findings = read_findings(os.path.join(data_dir, tid, "findings.json"))
        n_unresolved = sum(1 for f in findings if f.get("resolved") in (None, "fix"))
        rows.append(Row(
            id=tid,
            kind=meta.get("kind", "?"),
            project=project_name(meta),
            state=rt,
            waiting_on=waiting_on(rt, n_unresolved),
            rank=rank(rt, n_unresolved > 0),
            findings=findings,
            branch=meta.get("branch", ""),
            worktree=meta.get("worktree", ""),
            base=meta.get("base", ""),
            started=_mtime(path),
            active=_mtime(os.path.join(state_dir, "sessions", tid, "log")),
            report=meta.get("report", ""),
            approval=meta.get("approval", ""),
            delivered=meta.get("delivered", ""),
        ))
    rows.sort(key=lambda r: (r.rank, r.id))
    return rows


# ------------------------------------------------------------------ the queue (pure)
# The fleet is one of three sources the owner's actual queue spans. An item that has been added
# to the backlog but never grilled, or grilled and sitting on open questions, has no .meta at
# all — so it is invisible to build_fleet_model by construction. The queue joins:
#   data/backlog.md      ## slug: title + body        (injected as backlog_items)
#   data/<id>/spec.md    q: qid|state|source|at|text  (tl-spec.sh's flat encoding, read side)
#   state/<id>.meta      + tl-state + findings.json   (build_fleet_model)


@dataclass
class Q:
    qid: str
    state: str          # decided | leaning | open | spike
    source: str         # owner | inferred
    at: str
    text: str


@dataclass
class Spec:
    state: str          # drafted | specified | rejected
    title: str
    questions: list = field(default_factory=list)


@dataclass
class Target:
    """What an action key acts on, wherever the cursor happens to live. Views build one of these;
    the action handlers take nothing else, so d/l/s/x/e/r/g behave identically in all three."""
    task: str           # "tl-<slug>", or the bare slug for an item with no spec yet
    qid: str            # "" for item/task-level actions
    seed: str           # what the answer prompt starts with — see seed_for()
    slug: str
    text: str = ""      # the row in full, for the detail pane: table rows truncate, this doesn't


def seed_for(question):
    """Single owner of what the answer prompt is pre-filled with.

    spec.md's 5th field is dual-purpose (tl-spec.sh's encoding): for an OPEN question it holds the
    QUESTION, for an answered one it holds the ANSWER. So seeding from it is right only once the
    question has been answered — that is the accept-or-correct case, where the grill's inference is
    already there and you are agreeing with it or editing it. An open question starts empty: there
    is no inferred answer to accept, and pre-filling it with the question would invite answering
    the prompt by mangling the question."""
    return "" if question.state == "open" else question.text


@dataclass
class QRow:
    """One thing waiting on the owner. `what` is both the row's kind and its sort priority."""
    what: str           # gate|question|decision|blocked|failed|review|ready|backlog
    task: str           # task id ("tl-<slug>"), or the slug for a never-grilled item
    slug: str
    qid: str            # "" unless what == "question"
    detail: str
    title: str = ""
    fleet: object = None    # the fleet Row, when this came from a dispatched task
    spec: object = None     # the Spec, when the item has been grilled

    @property
    def key(self):
        return "%s|%s|%s" % (self.what, self.task, self.qid)

    @property
    def rank(self):
        return _QRANK.get(self.what, 9)

    @property
    def target(self):
        q = self.question
        return Target(self.task, self.qid, seed_for(q) if q else "", self.slug)

    @property
    def question(self):
        if self.what != "question" or not self.spec:
            return None
        for x in self.spec.questions:
            if x.qid == self.qid:
                return x
        return None


@dataclass
class Queue:
    rows: list = field(default_factory=list)    # sorted, loudest first
    quiet: list = field(default_factory=list)   # fleet Rows that need nothing (working/paused)
    items: list = field(default_factory=list)   # (slug, title, id, stage, n_open, n_total)


# The two decisions TechLead exists to slow down — gate findings and grill questions — rank above
# everything else. Un-grilled backlog items sit at the bottom: they are work you have not asked
# for yet, not work that is stuck.
_QRANK = {
    "gate": 0,          # unresolved findings — the delivery gate is holding
    "question": 1,      # an open grill question blocks dispatch
    "decision": 2,      # a worker is waiting on an answer
    "blocked": 3,
    "failed": 4,
    "review": 5,        # deliverable ready
    "ready": 6,         # specified, never dispatched
    "working": 7,       # a worker is running — nothing is needed from you, but you want to watch it
    "backlog": 8,       # never grilled
    "retire": 9,        # finished and signed off — teardown is bookkeeping, but it frees a worktree
}


def qid_key(qid):
    """Sort qids as numbers, not strings: as a spec grows past nine questions, plain string order
    puts q10 between q1 and q2, so working down the open list jumps around."""
    m = re.match(r"^([^0-9]*)(\d+)(.*)$", qid or "")
    return (m.group(1), int(m.group(2)), m.group(3)) if m else (qid or "", 0, "")


def slugify(s):
    """Mirror of tl-grill.sh's slugify — the id is 'tl-' + this, so it must not drift."""
    out = "".join(c if c.isalnum() else "-" for c in s.lower())
    while "--" in out:
        out = out.replace("--", "-")
    return out.strip("-")


def read_spec(path):
    """data/<id>/spec.md -> Spec, or None if absent. Read side of tl-spec.sh's encoding (§3.10):
    front matter between the first two '---', one pipe-encoded line per question."""
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    spec, n = Spec(state="", title=""), 0
    for ln in lines:
        if ln == "---":
            n += 1
            if n == 2:
                break
            continue
        if n != 1:
            continue
        if ln.startswith("state: "):
            spec.state = ln[7:].strip()
        elif ln.startswith("title: "):
            spec.title = ln[7:].strip()
        elif ln.startswith("q: "):
            parts = ln[3:].split("|", 4)
            if len(parts) == 5:
                spec.questions.append(Q(*parts))
    return spec


def read_ask(path):
    """data/<id>/ask (key=value) — the pending escalation tl-escalate would present. Absent -> {}."""
    return read_meta(path)


def build_queue_model(state_dir, data_dir, state_of, backlog_items):
    """Pure: (fixture state, [(slug, title)]) -> Queue. backlog_items is injected for the same
    reason state_of is — so this whole function is assertable without a terminal or a subprocess."""
    q = Queue()
    for slug, title in backlog_items:
        tid = "tl-" + slugify(slug)
        spec = read_spec(os.path.join(data_dir, tid, "spec.md"))
        has_meta = os.path.exists(os.path.join(state_dir, tid + ".meta"))
        if spec is None:
            q.items.append((slug, title, "", "backlog", 0, 0))
            q.rows.append(QRow("backlog", slug, slug, "", "never grilled", title=title))
            continue
        opens = [x for x in spec.questions if x.state == "open"]
        stage = spec.state or "drafted"
        if not opens and not has_meta and stage != "rejected":
            stage = "specified"
        q.items.append((slug, title or spec.title, tid, stage, len(opens), len(spec.questions)))
        if spec.state == "rejected":
            continue        # terminal "don't build this" (D10) — decided, so it stops nagging
        for x in opens:
            q.rows.append(QRow("question", tid, slug, x.qid, "%s  %s" % (x.qid, x.text),
                               title=title or spec.title, spec=spec))
        if not opens and not has_meta:
            q.rows.append(QRow("ready", tid, slug, "",
                               "specified — %d answered, nothing dispatched" % len(spec.questions),
                               title=title or spec.title, spec=spec))

    by_slug = {}
    for slug, title, tid, _stage, _o, _t in q.items:
        if tid:
            by_slug[tid] = (slug, title)

    for r in build_fleet_model(state_dir, data_dir, state_of):
        slug, title = by_slug.get(r.id, ("", ""))
        spec = read_spec(os.path.join(data_dir, r.id, "spec.md"))
        open_f = [f for f in r.findings if f.get("resolved") in (None, "fix")]
        common = dict(slug=slug or r.id, title=title, fleet=r, spec=spec)
        if open_f:
            rules = ", ".join(sorted({f.get("rule", "?") for f in open_f}))
            q.rows.append(QRow("gate", r.id, qid="", detail="%d finding%s: %s"
                               % (len(open_f), "" if len(open_f) == 1 else "s", rules), **common))
            continue
        base = _base_state(r.state)
        if base == "needs-decision":
            ask = read_ask(os.path.join(data_dir, r.id, "ask")).get("question", "")
            q.rows.append(QRow("decision", r.id, qid="",
                               detail="worker asks: " + ask if ask else "worker needs a decision",
                               **common))
        elif base in ("blocked", "failed"):
            q.rows.append(QRow(base, r.id, qid="", detail=r.state, **common))
        elif base == "done":
            signed = r.approval or r.delivered
            if signed:
                # already signed off: it is finished, and what is left is releasing its worktree.
                # Saying "approve, skip or fix" here is the system asking for a decision you made.
                q.rows.append(QRow("retire", r.id, qid="",
                                   detail="%s — t to retire it and free its worktree" % signed,
                                   **common))
            else:
                q.rows.append(QRow("review", r.id, qid="",
                                   detail="%s report ready: approve, skip or fix" % r.kind,
                                   **common))
        else:
            # working / paused. Nothing is needed from you, so it ranks near the bottom — but it
            # stays a ROW: collapsing the task you just dispatched into a one-line summary meant
            # the thing you were waiting on was the one thing you could not watch.
            q.quiet.append(r)     # kept for `:fleet`, which lists the live fleet
            q.rows.append(QRow("working", r.id, qid="", detail=_run_detail(r), **common))

    q.rows.sort(key=lambda r: (r.rank, r.task, qid_key(r.qid)))
    return q


# --------------------------------------------------------------------------- selftest
def _selftest():
    fail = []
    def check(cond, msg):
        if not cond:
            fail.append(msg)

    tmp = tempfile.mkdtemp(prefix="tl-top-selftest.")
    state_dir = os.path.join(tmp, "state")
    data_dir = os.path.join(tmp, "data")
    os.makedirs(state_dir)
    os.makedirs(data_dir)
    metas = {
        "tl-a": ("kind=change\npname=proj1\nproject=/x/proj1\nstate=working\n"
                 "branch=tl/tl-a\nworktree=/x/proj1/.techlead/state/wt/tl-a\nbase=9f2a1c4d\n"
                 "approval=approve\n"),
        "tl-b": "kind=plan\npname=proj1\nstate=working\n",
        "tl-c": "kind=change\npname=proj2\nstate=working\n",
        "tl-d": "kind=plan\npname=proj1\nstate=done\n",   # torn down -> excluded
        "tl-e": "kind=change\npname=proj2\nstate=working\n",
        "tl-f": "kind=plan\npname=proj1\nstate=working\n",
        "tl-signed": "kind=plan\npname=proj1\nstate=working\napproval=approve\n",
        "tl-g": "kind=change\npname=proj3\nstate=working\n",
        "tl-h": "kind=plan\npname=proj3\nstate=working\n",
        "tl-i": "kind=answer\npname=proj3\nstate=working\n",
    }
    for k, v in metas.items():
        with open(os.path.join(state_dir, k + ".meta"), "w") as f:
            f.write(v)
    os.makedirs(os.path.join(data_dir, "tl-a"))
    with open(os.path.join(data_dir, "tl-a", "findings.json"), "w") as f:
        json.dump([
            {"id": "f1", "class": "ask-user", "rule": "test-regression", "detail": "x", "resolved": None},
            {"id": "f2", "class": "ask-user", "rule": "scope-cap", "detail": "y", "resolved": "fix"},
            {"id": "f3", "class": "ask-user", "rule": "danger", "detail": "z", "resolved": "approve"},
        ], f)

    runtime = {"tl-a": "done", "tl-b": "needs-decision", "tl-c": "working",
               "tl-e": "failed", "tl-f": "done", "tl-g": "paused", "tl-signed": "done",
               "tl-h": "paused:owner-review", "tl-i": "unknown"}
    state_of = lambda i: runtime.get(i, "unknown")
    model = build_fleet_model(state_dir, data_dir, state_of)

    ids = [r.id for r in model]
    check(ids == ["tl-a", "tl-b", "tl-e", "tl-f", "tl-signed", "tl-g", "tl-h", "tl-c", "tl-i"],
          "priority order / torn-down exclusion wrong: %r" % ids)
    by = {r.id: r for r in model}
    if by.get("tl-a"):
        a = by["tl-a"]
        check(a.rank == 0, "unresolved-findings task must rank top, got %r" % a.rank)
        check(a.waiting_on == "2 finding(s)", "waiting_on for findings: %r" % a.waiting_on)
        check(a.kind == "change" and a.project == "proj1", "kind/project mapping")
        check(len(a.findings) == 3, "all findings attached to the row")
    # every task has its own worktree + branch (tl-spawn, §3.11); parallel workers are the norm,
    # so the row has to say WHICH one — `g` merges that branch, not some ambient current one.
    check(bool(by.get("tl-a")) and by["tl-a"].branch == "tl/tl-a"
          and by["tl-a"].worktree.endswith("/wt/tl-a") and by["tl-a"].base == "9f2a1c4d",
          "the fleet row must carry branch/worktree/base from the meta")
    check(bool(by.get("tl-b")) and by["tl-b"].branch == "",
          "a meta without them is fine — the row just has nothing to show")
    wl = worktree_lines(by["tl-a"], "/somewhere/else")
    check(wl[0] == "worktree  .techlead/state/wt/tl-a",
          "the worktree path is shown relative to the project, symlinked or not: %r" % wl[0])
    check(wl[1].startswith("branch    tl/tl-a   base 9f2a1c4") and "worktree gone" in wl[1],
          "a missing worktree is called out rather than silently blank: %r" % wl[1])
    check(worktree_lines(by["tl-b"]) == [], "no branch/worktree recorded -> nothing to draw")
    check(bool(by.get("tl-b")) and by["tl-b"].waiting_on == "decision", "needs-decision -> 'decision'")
    check(bool(by.get("tl-e")) and by["tl-e"].waiting_on == "failed", "failed -> 'failed'")
    check(bool(by.get("tl-f")) and by["tl-f"].waiting_on == "review", "done -> 'review'")
    check(by["tl-f"].approval == "" and by["tl-a"].approval == "approve",
          "the row must carry the sign-off tl-approve/tl-deliver recorded")
    check(bool(by.get("tl-c")) and by["tl-c"].waiting_on == "", "working -> quiet ('')")
    check(bool(by.get("tl-g")) and by["tl-g"].waiting_on == "paused" and by["tl-g"].rank == 5,
          "paused recedes (rank 5)")
    check(bool(by.get("tl-h")) and by["tl-h"].waiting_on == "paused",
          "paused:reason -> base 'paused'")
    check(bool(by.get("tl-i")) and by["tl-i"].waiting_on == "unknown" and by["tl-i"].rank == 7,
          "unknown state sinks to the bottom")
    check(build_fleet_model(state_dir + "-nope", data_dir, lambda i: "working") == [],
          "missing/empty state dir -> []")

    # ---- the queue: backlog + specs + fleet, joined ----
    def spec_file(tid, body):
        os.makedirs(os.path.join(data_dir, tid), exist_ok=True)
        with open(os.path.join(data_dir, tid, "spec.md"), "w") as fh:
            fh.write(body)

    # tl-a is dispatched AND has unresolved findings -> a gate row (and its spec is fully answered)
    spec_file("tl-a", "---\nid: tl-a\nstate: specified\ntitle: A thing\n"
                      "q: q1|decided|inferred|2026-08-14|use the existing index\n---\n# A thing\n")
    # grilled, two open questions, never dispatched -> two question rows, no ready row
    spec_file("tl-open", "---\nid: tl-open\nstate: drafted\ntitle: Open item\n"
                         "q: q1|decided|inferred|2026-08-14|keep the old path\n"
                         "q: q3|open|inferred|2026-08-14|what happens to the old index?\n"
                         "q: q7|open|inferred|2026-08-14|who owns the migration?\n"
                         "q: q10|open|inferred|2026-08-14|what does the rollback cost?\n---\n")
    # fully answered, never dispatched -> one ready row
    spec_file("tl-ready", "---\nid: tl-ready\nstate: specified\ntitle: Ready item\n"
                          "q: q1|decided|owner|2026-08-14|do it the simple way\n---\n")
    # rejected -> no row at all (terminal decision), but still listed as an item
    spec_file("tl-nope", "---\nid: tl-nope\nstate: rejected\ntitle: Rejected item\n"
                         "q: q1|decided|owner|2026-08-14|no\n---\n")
    os.makedirs(os.path.join(data_dir, "tl-b"), exist_ok=True)
    with open(os.path.join(data_dir, "tl-b", "ask"), "w") as fh:
        fh.write("question=reuse the retry helper?\ndefault=yes\ntimeout=30\n")

    backlog = [("a", "A thing"), ("open", "Open item"), ("ready", "Ready item"),
               ("nope", "Rejected item"), ("fresh", "Never grilled")]
    q = build_queue_model(state_dir, data_dir, state_of, backlog)

    whats = [(r.what, r.task, r.qid) for r in q.rows]
    check(whats[0] == ("gate", "tl-a", ""), "gate must rank first, got %r" % (whats[:1],))
    check([w[2] for w in whats if w[0] == "question"] == ["q3", "q7", "q10"],
          "one row per OPEN question, in NUMERIC qid order (q10 last, not between q1 and q2): %r"
          % [w[2] for w in whats if w[0] == "question"])
    check(qid_key("q10") > qid_key("q9") and qid_key("q2") < qid_key("q10")
          and qid_key("") == ("", 0, "") and qid_key("qi1") > qid_key("q9"),
          "qid_key: numeric within a prefix, and it must not choke on '' or the qi<n> form")
    check(("ready", "tl-ready", "") in whats, "fully-answered + undispatched -> a ready row")
    check(("backlog", "fresh", "") in whats, "un-grilled backlog item -> a backlog row")
    # the reported bug: approving a plan changed nothing, so the row went on asking for approval
    sgn = [r for r in q.rows if r.task == "tl-signed"]
    check(len(sgn) == 1 and sgn[0].what == "retire" and "approve" in sgn[0].detail,
          "an APPROVED plan must stop asking to be approved: %r"
          % [(r.what, r.detail) for r in sgn])
    check("approve, skip or fix" not in sgn[0].detail,
          "...and must not repeat the decision you already made")
    check(not [w for w in whats if w[1] == "tl-nope"], "a rejected item must produce no row")
    # The order is the design, so it is spelled out rather than derived from _QRANK — the two
    # decisions TechLead exists to slow down (gate findings, grill questions) sit above everything,
    # and un-grilled backlog items sink to the bottom.
    check(whats == [("gate", "tl-a", ""), ("question", "tl-open", "q3"),
                    ("question", "tl-open", "q7"), ("question", "tl-open", "q10"),
                    ("decision", "tl-b", ""),
                    ("failed", "tl-e", ""), ("review", "tl-f", ""),
                    ("ready", "tl-ready", ""),
                    ("working", "tl-c", ""), ("working", "tl-g", ""),
                    ("working", "tl-h", ""), ("working", "tl-i", ""),
                    ("backlog", "fresh", ""), ("retire", "tl-signed", "")],
          "queue order wrong: %r" % (whats,))
    dec = [r for r in q.rows if r.what == "decision"]
    check(len(dec) == 1 and dec[0].detail == "worker asks: reuse the retry helper?",
          "needs-decision row should quote data/<id>/ask: %r" % [r.detail for r in dec])
    check(sorted(r.id for r in q.quiet) == ["tl-c", "tl-g", "tl-h", "tl-i"],
          "working/paused/unknown stay in `quiet` for :fleet: %r" % [r.id for r in q.quiet])
    # ...and ALSO get a row, so the task you just dispatched is watchable rather than collapsed
    # into a one-line summary at the bottom of the screen
    wrk = {r.task: r for r in q.rows if r.what == "working"}
    check(set(wrk) == {"tl-c", "tl-g", "tl-h", "tl-i"},
          "every live task must have a row: %r" % sorted(wrk))
    check("last output" in wrk["tl-c"].detail or "no output yet" in wrk["tl-c"].detail,
          "a running row must say when it last made a sound: %r" % wrk["tl-c"].detail)
    check(wrk["tl-g"].detail.startswith("paused"),
          "a paused row must lead with why it is not working: %r" % wrk["tl-g"].detail)
    check(_run_detail(by["tl-c"], now=by["tl-c"].started + 4000).startswith("1h"),
          "elapsed is rendered compactly: %r" % _run_detail(by["tl-c"], now=by["tl-c"].started + 4000))
    check(len({r.key for r in q.rows}) == len(q.rows), "row keys must be unique (the cursor uses them)")

    items = {i[0]: i for i in q.items}
    check(items["fresh"][3] == "backlog" and items["fresh"][2] == "", "never-grilled item stage")
    check(items["open"][3] == "drafted" and items["open"][4] == 3, "open item: stage + open count")
    check(items["ready"][3] == "specified" and items["ready"][4] == 0, "ready item: stage + 0 open")
    check(items["nope"][3] == "rejected", "rejected item keeps its stage in the item list")
    check(items["a"][2] == "tl-a", "slug -> id join is 'tl-' + slugify(slug)")

    check(slugify("Add Search!") == "add-search", "slugify must mirror tl-grill's")
    check(read_spec(os.path.join(data_dir, "nope", "spec.md")) is None, "missing spec -> None")
    empty = build_queue_model(state_dir + "-nope", data_dir + "-nope", state_of, [])
    check(empty.rows == [] and empty.quiet == [], "missing dirs + empty backlog -> empty queue")

    # ---- view 3's tables (pure too: same fixture, no terminal) ----
    lead_dir = os.path.join(tmp, "lead")
    os.makedirs(lead_dir)
    with open(os.path.join(lead_dir, "questions.md"), "w") as fh:
        fh.write("# bank\n\n### what breaks that already works?\nhits: 4   last: 2026-08-14\n"
                 "_scar:_ the 2024 reindex dropped 11k rows\n\n### who owns the rollback?\nhits: 0\n")
    crumb, _hdr, mrows = modal_table("backlog", "", q, data_dir, lead_dir)
    check(crumb == "techlead > backlog" and len(mrows) == 5,
          "':backlog' lists every item incl. rejected + never-grilled: %d" % len(mrows))
    _c, _h, mrows = modal_table("q", "open", q, data_dir, lead_dir)
    targets = [r[1] for r in mrows]
    check([(t.task, t.qid) for t in targets]
          == [("tl-open", "q1"), ("tl-open", "q3"), ("tl-open", "q7"), ("tl-open", "q10")],
          "':q <slug>' must list EVERY question — the answered ones are only reachable here: %r"
          % [(t.task, t.qid) for t in targets])
    # the accept-or-correct rule: an answered question seeds the prompt with its answer, an open
    # one starts empty (spec.md's 5th field is the QUESTION while open — see seed_for).
    check(targets[0].seed == "keep the old path", "answered question must seed the prompt with its answer")
    check(all(t.seed == "" for t in targets[1:]), "an OPEN question must seed empty")
    keys = {r.key for r in q.rows}
    check(all("question|%s|%s" % (t.task, t.qid) in keys for t in targets[1:]),
          "an open question's modal row must resolve to a real queue row (the cursor carries on it)")
    check("question|tl-open|q1" not in keys,
          "an ANSWERED question must have no queue row — it is not waiting on anyone")
    _c, _h, mrows = modal_table("bank", "", q, data_dir, lead_dir)
    check(len(mrows) == 2 and mrows[0][0].startswith("4  "),
          "':bank' shows lead/questions.md with its hit counts: %r" % [r[0] for r in mrows])
    _c, _h, mrows = modal_table("findings", "tl-a", q, data_dir, lead_dir)
    check(len(mrows) == 3 and mrows[0][0].startswith("! "),
          "':findings <id>' marks unresolved with '!': %r" % [r[0] for r in mrows])
    _c, _h, mrows = modal_table("q", "not-a-thing", q, data_dir, lead_dir)
    check(len(mrows) == 1 and mrows[0][1] is None, "':q' on an un-grilled slug says so, selects nothing")
    _c, hdr, mrows = modal_table("fleet", "", q, data_dir, lead_dir)
    check(len(mrows) == len(q.quiet) + len([r for r in q.rows if r.fleet]),
          "':fleet' shows every live task, loud ones first")
    check("BRANCH" in hdr and any("tl/tl-a" in r[0] for r in mrows),
          "':fleet' must name each task's branch — that is what `g` merges: %r" % [r[0] for r in mrows])
    check(any(" -" in r[0] for r in mrows),
          "a task with no recorded branch shows '-' rather than a blank column")

    # ---- the inbox table's own layout: DETAIL wraps under its column, rows are variable height ----
    long_q = ("What happens to the old index while the new one builds, and who owns the rollback "
              "if the migration has to be abandoned halfway through a busy weekday afternoon?")
    layout = [QRow("question", "tl-open", "open", "q3", "q3  " + long_q),
              QRow("backlog", "fresh", "fresh", "", "never grilled")]
    W = 80
    head_w, lines = inbox_lines(layout, W)
    check(all(len(t) <= W for _i, t in lines),
          "no inbox line may exceed the window: %r" % [len(t) for _i, t in lines])
    q3 = [t for i, t in lines if i == 0]
    check(len(q3) > 1, "a long detail must occupy several lines, not be clipped: %r" % q3)
    check(q3[0].startswith("● question tl-open"), "the first line carries the row's columns")
    check(all(t[:head_w].strip() == "" for t in q3[1:]),
          "continuation lines must be blank in the WHAT/TASK columns: %r" % q3[1:])
    rebuilt = " ".join(" ".join(t[head_w:] for t in q3).split())
    check(rebuilt == " ".join(layout[0].detail.split()),
          "the table must show the detail in FULL — nothing lost to the window edge:\n  want %r\n  got  %r"
          % (layout[0].detail, rebuilt))
    short = [t for i, t in lines if i == 1]
    check(len(short) == 1 and short[0].startswith("○ backlog")
          and short[0][:head_w].rstrip().endswith("fresh")
          and short[0][head_w:] == "never grilled",
          "a short detail still takes exactly one line, in its columns: %r" % short)
    check(len(inbox_lines(layout, 400)[1]) == 2, "a wide window needs no wrapping at all")
    # the TASK column is the owner's own id, so it is sized to fit rather than clipped
    check(head_w == 12 + 8, "short ids keep the column at its 8-char minimum: %d" % head_w)
    real = [QRow("question", "tl-notes-file-location", "notes-file-location", "q11", "why?")]
    for width in (80, 120):
        hw, wl = inbox_lines(real, width)
        check("tl-notes-file-location " in wl[0][1],
              "a real id must never be clipped (it IS the id) at w=%d: %r" % (width, wl[0][1]))
        check(hw == 12 + len("tl-notes-file-location"), "column sized to it: %d" % hw)
    absurd = [QRow("question", "tl-" + "x" * 90, "s", "q1", "the prose still needs room")]
    hw, wl = inbox_lines(absurd, 80)
    check(hw <= 12 + 80 // 3 and all(len(t) < 80 for _i, t in wl),
          "but the column is bounded, so one absurd id cannot crowd out the prose: hw=%d" % hw)

    import shutil
    shutil.rmtree(tmp, ignore_errors=True)
    if fail:
        for m in fail:
            print("FAIL:", m)
        sys.exit(1)
    print("PASS: tl-top fleet model (priority order, exclusion, waiting-on)")
    print("PASS: tl-top queue model (backlog+spec+fleet join, rank order, cursor keys)")
    print("PASS: tl-top modal tables (backlog/q/bank/findings/fleet, keys resolve to queue rows)")
    print("PASS: tl-top inbox layout (DETAIL wraps under its column, rows vary in height)")


# ----------------------------------------------------------------- instance + shell-outs
BIN = os.path.dirname(os.path.abspath(__file__))
_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")   # ids come from filenames — validate before use


def _tl_home():
    return os.environ.get("TL_HOME", "")


def _guard():
    """Same capability guard as tl-common.sh (§3.9): only operate inside a real instance."""
    home = _tl_home()
    if not home:
        sys.exit("tl-top: refusing — TL_HOME is not set (capability guard, §3.9)")
    if not os.path.isfile(os.path.join(home, "AGENTS.md")):
        sys.exit("tl-top: refusing — TL_HOME (%s) is not a TechLead instance (no AGENTS.md)" % home)


def _tl_root():
    """Nearest ancestor .techlead/ (per-project state, mirrors tl-common's walk-up); else TL_HOME.
    An explicit TL_STATE/TL_DATA still wins in _state_paths()."""
    d = os.getcwd()
    while d != "/":
        if os.path.isdir(os.path.join(d, ".techlead")):
            return os.path.join(d, ".techlead")
        d = os.path.dirname(d)
    return _tl_home()


def _state_paths():
    root = _tl_root()
    return (os.environ.get("TL_STATE") or os.path.join(root, "state"),
            os.environ.get("TL_DATA") or os.path.join(root, "data"))


def _lead_path():
    return os.environ.get("TL_LEAD") or os.path.join(_tl_root(), "lead")


def _backlog_path():
    return os.environ.get("TL_BACKLOG") or os.path.join(_state_paths()[1], "backlog.md")


def _run_capture(argv):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        return r.stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def _run_cmd(argv):
    """Run a tl-* command without leaving the TUI, for the ones that print a line and exit.
    Returns (rc, last-meaningful-line). The command still owns the write and its refusals —
    only the *presentation* differs from _shell_out's full-screen handoff."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "could not run %s (%s)" % (os.path.basename(argv[0]), e)
    out = [ln for ln in ((r.stdout or "") + (r.stderr or "")).splitlines() if ln.strip()]
    return r.returncode, (out[-1] if out else "")


def tl_state(tid):
    """Authoritative current state (§3.4) — the injected state_of for the real fleet."""
    if not _ID_RE.match(tid):
        return "unknown"
    return _run_capture([os.path.join(BIN, "tl-state.sh"), tid]).strip() or "unknown"


def tl_peek(tid, n):
    if not _ID_RE.match(tid):
        return ""
    return _run_capture([os.path.join(BIN, "tl-peek.sh"), tid, str(n)])


def tl_spec_path(tid):
    if not _ID_RE.match(tid):
        return ""
    return _run_capture([os.path.join(BIN, "tl-spec.sh"), "path", tid]).strip()


def tl_backlog_list():
    """[(slug, title)] — via tl-backlog, which owns the heading format (§3.1). Never our own awk."""
    items = []
    for ln in _run_capture([os.path.join(BIN, "tl-backlog.sh"), "list"]).splitlines():
        slug, sep, title = ln.strip().partition(": ")
        if sep and _ID_RE.match(slug):
            items.append((slug, title))
    return items


def tl_backlog_show(slug):
    """(line, title, body) for one item, or (0, '', '') — the read side of tl-backlog."""
    if not _ID_RE.match(slug):
        return 0, "", ""
    out = _run_capture([os.path.join(BIN, "tl-backlog.sh"), "show", slug]).splitlines()
    if not out:
        return 0, "", ""
    line, _, title = out[0].partition("\t")
    try:
        return int(line), title, "\n".join(out[1:]).strip()
    except ValueError:
        return 0, "", ""


def current_project():
    """The sole project registered in this instance — mirrors tl_current_project (one per repo now).
    Returns "" when zero or several are registered, since then there is nothing unambiguous to say."""
    confs = sorted(glob.glob(os.path.join(_state_paths()[1], "projects", "*.conf")))
    return os.path.basename(confs[0])[:-len(".conf")] if len(confs) == 1 else ""


def _readiness_note():
    """Why every task is coming out as a `plan`, said where you would otherwise wonder.

    tl-spawn picks the kind from the project's readiness (§2.7): survey -> plan, ready -> change.
    A repo with no test harness has no completion criterion, so a worker is not allowed to change
    code — but nothing said so, which reads as the tool refusing to implement anything."""
    name = current_project()
    if not name:
        return []
    r = _run_capture([os.path.join(BIN, "tl-project.sh"), "get", name, "readiness"]).strip()
    if r != "survey":
        return []
    return ["── %s · readiness: survey — every task spawns as a `plan` " % name + "─" * 30,
            "no test harness, so a worker has no way to tell whether it broke something."
            "   H drafts one (tl-scaffold-test)"]


def read_bank(path):
    """lead/questions.md -> [(question, hits, scar)]. The bank is the asset (§2.6), so `3 bank`
    shows it with its hit counts; the file's shape is lead/SHAPE.md's."""
    entries = []
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    cur = None
    for ln in lines:
        if ln.startswith("### "):
            cur = [ln[4:].strip(), "0", ""]
            entries.append(cur)
        elif cur is not None and ln.startswith("hits:"):
            cur[1] = ln[5:].split()[0] if ln[5:].split() else "0"
        elif cur is not None and ln.startswith("_scar:_"):
            cur[2] = ln[7:].strip()
    return [tuple(e) for e in entries]


# ----------------------------------------------------------------------------- curses UI
import curses            # noqa: E402  (kept below the pure/testable core; --selftest never initscr's)
import curses.textpad    # noqa: E402

CP_LOUD, CP_STUCK, CP_READY, CP_QUIET = 1, 2, 3, 4

# what -> (colour bucket, label). The bucket mirrors the fleet's: loud = act now, stuck = stuck,
# ready = a deliverable is waiting, quiet = background.
_WHAT_ATTR = {
    "gate": "loud", "question": "loud", "decision": "loud",
    "blocked": "stuck", "failed": "stuck",
    "review": "ready", "ready": "ready", "retire": "quiet", "working": "quiet",
    "backlog": "stuck",
}
_ANSWER_KEYS = {ord("d"): "decided", ord("l"): "leaning", ord("s"): "spike"}
_EDITORS_WITH_PLUS = {"vi", "vim", "nvim", "view", "nano", "pico", "emacs", "emacsclient",
                      "kak", "hx", "helix", "micro"}


def _interval_ms():
    try:
        return max(200, int(float(os.environ.get("TL_TOP_INTERVAL", "2")) * 1000))
    except ValueError:
        return 2000


def _bucket_attr(bucket, bold=True):
    if not curses.has_colors():
        return curses.A_BOLD if bucket in ("loud", "stuck") else curses.A_NORMAL
    pair = {"loud": CP_LOUD, "stuck": CP_STUCK, "ready": CP_READY, "quiet": CP_QUIET}[bucket]
    a = curses.color_pair(pair)
    if bucket == "loud" and bold:
        a |= curses.A_BOLD
    if bucket == "quiet":
        a |= curses.A_DIM
    return a


def _rank_attr(rank_val):
    if not curses.has_colors():
        return curses.A_BOLD if rank_val <= 3 else curses.A_NORMAL
    if rank_val <= 1:                       # findings / needs-decision — act now
        return curses.color_pair(CP_LOUD) | curses.A_BOLD
    if rank_val <= 3:                       # blocked / failed — stuck
        return curses.color_pair(CP_STUCK) | curses.A_BOLD
    if rank_val == 4:                       # done — ready for review
        return curses.color_pair(CP_READY)
    return curses.color_pair(CP_QUIET) | curses.A_DIM   # working / paused — recede


def _addln(win, y, x, s, attr=0):
    h, w = win.getmaxyx()
    if 0 <= y < h and x < w:
        try:
            win.addnstr(y, x, s, w - x - 1, attr)   # -1 dodges the bottom-right-corner error
        except curses.error:
            pass


def _bar(win, y, left, right="", attr=None):
    """A full-width reverse-video bar — tl-top's header/footer idiom.

    The RIGHT side wins when they don't both fit: it carries the key hints, and a long left side
    (a notice, or a prompt label quoting a whole question) would otherwise push them off screen
    exactly when you need to know how to get out."""
    _h, w = win.getmaxyx()
    room = w - len(right) - 2
    if len(left) > room:
        left = left[: max(0, room - 1)] + "…"
    pad = max(1, w - len(left) - len(right) - 1)
    _addln(win, y, 0, (left + " " * pad + right).ljust(w),
           (curses.A_REVERSE | curses.A_BOLD) if attr is None else attr)


def _tabs(view):
    return "".join(("[%d %s]" % (n, name)).ljust(13) if n == view
                   else (" %d %s " % (n, name)).ljust(13)
                   for n, name in ((1, "inbox"), (2, "briefing"), (3, "modal")))


# ------------------------------------------------------------------------ view 1: inbox
def inbox_lines(rows, w):
    """(head_w, [(row_index, text)]) — one entry per SCREEN line, DETAIL wrapped under its column.

    A row is as tall as its text needs. The detail is a question or a worker's ask, written by a
    person, and the point of the list is to read it — so it wraps here rather than being clipped at
    the window edge with the full text only available one keypress away.

    The TASK column is sized to the widest id actually present rather than a fixed width: ids are
    `tl-` + the backlog slug, so they are as long as the owner's own naming, and a truncated one is
    not an id any more. It is still bounded, so a single absurd slug can't crowd out the prose.
    Pure, so the layout is assertable without a terminal."""
    ids = [(r.task or r.slug) for r in rows] or [""]
    task_w = min(max(8, max(len(i) for i in ids)), max(12, w // 3))
    head_w = 12 + task_w        # "● " + what(8) + " " + task(task_w) + " "
    out = []
    for i, r in enumerate(rows):
        mark = {"backlog": "○", "working": "◐", "retire": "✓"}.get(r.what, "●")
        head = "%s %-8s %-*s " % (mark, r.what[:8], task_w, (r.task or r.slug)[:task_w])
        for j, ln in enumerate(_wrap(r.detail, max(8, w - head_w - 1))):
            out.append((i, (head if j == 0 else " " * head_w) + ln))
    return head_w, out


def _draw_inbox(win, st, q, data_dir):
    h, w = win.getmaxyx()
    readiness_note = _readiness_note()
    rows = _filtered(q.rows, st["filter"])
    _bar(win, 0, " " + _tabs(1),
         "%d waiting · %d working " % (len(q.rows), len(q.quiet)))
    head_w, lines = inbox_lines(_filtered(q.rows, st["filter"]), w)
    _addln(win, 1, 0, "%-11s%-*s%s" % ("WHAT", head_w - 11, "TASK", "DETAIL"), curses.A_UNDERLINE)
    if not rows:
        _addln(win, 3, 0, "  nothing is waiting on you." if not st["filter"]
               else "  nothing matches /%s" % st["filter"])
        _foot_inbox(win, st, q)
        return

    sel = _index_of(rows, st["cursor"])
    body_h = max(3, (h - 5) * 2 // 3)      # wrapped rows are taller, so the list gets the bigger half

    # Rows are variable height now, so scroll by LINE while keeping the whole selected row on
    # screen — anchoring on its last line, then pulling back if that hid its first.
    span = [k for k, (i, _) in enumerate(lines) if i == sel] or [0]
    top = max(0, span[-1] - body_h + 1)
    top = min(top, span[0])

    drawn = 0
    for k in range(top, min(len(lines), top + body_h)):
        i, text = lines[k]
        attr = curses.A_REVERSE if i == sel else _bucket_attr(_WHAT_ATTR.get(rows[i].what, "quiet"))
        _addln(win, 2 + drawn, 0, text.ljust(w), attr)
        drawn += 1

    y = 2 + drawn + 1
    y = _draw_detail(win, rows[sel], y, h - 2, data_dir)
    if readiness_note and y < h - 2:
        for i, ln in enumerate(readiness_note[-2:]):
            _addln(win, h - 3 + i, 0, ln, _bucket_attr("stuck", bold=False))
    _foot_inbox(win, st, q, rows[sel])


def _foot_inbox(win, st, q, row=None):
    h, _ = win.getmaxyx()
    if st["notice"]:
        _bar(win, h - 1, " " + st["notice"], " (any key) ")
        return
    # `g` and `d/l/s` only mean something on particular rows, so the footer names what THIS row
    # answers to rather than a fixed list you have to learn the exceptions to.
    if row is not None and row.what == "backlog":
        keys = " g grill   r run (grill+dispatch)   e edit   x drop   / filter"
    elif row is not None and row.what == "question":
        keys = " d/l/s answer   e edit   x reject   r run   / filter"
    elif row is not None and row.what == "gate":
        keys = " g gate   p peek   e edit   r run   / filter"
    elif row is not None and row.what == "review":
        keys = " p read the report   g approve/deliver   e edit   r run   / filter"
    elif row is not None and row.what == "retire":
        keys = " t retire (frees the worktree)   p read the report   / filter"
    elif row is not None and row.what == "working":
        keys = " p follow its log   3 fleet   e edit   / filter"
    else:
        keys = " r run   g gate   p peek   e edit   / filter"
    _bar(win, h - 1, keys, "? help   q quit ")


def _draw_detail(win, r, y, ymax, data_dir):
    """The pane under the inbox: what this row actually is, in the row's own terms.

    Table rows are one line each and truncate — that is what makes a table scannable. This pane
    is the other half of that bargain: it is where the full text has to be readable, so
    everything here wraps."""
    if y >= ymax:
        return y
    if r.what == "question":
        qq = r.question
        y = _rule(win, y, r.qid)
        y = _para(win, y, ymax, 0, qq.text if qq else r.detail, curses.A_BOLD)
        if qq and y < ymax:
            _addln(win, y, 0, "state %s · source %s · asked %s" % (qq.state, qq.source, qq.at),
                   _bucket_attr("quiet")); y += 1
        done = [x for x in (r.spec.questions if r.spec else []) if x.state != "open"]
        if done and y < ymax:
            _addln(win, y, 0, "%d already decided here — 2 briefing shows them in full"
                   % len(done), _bucket_attr("quiet")); y += 1
    elif r.what == "gate":
        for ln in fleet_lines(r.fleet, os.path.dirname(os.path.dirname(data_dir))):
            if y < ymax:
                _addln(win, y, 0, ln, _bucket_attr("quiet")); y += 1
        y = _rule(win, y, "findings")
        for f in (r.fleet.findings if r.fleet else []):
            if y >= ymax:
                break
            open_ = f.get("resolved") in (None, "fix")
            y = _para(win, y, ymax, 2, f.get("detail", ""),
                      curses.A_BOLD if open_ else curses.A_DIM,
                      label="%s [%s] %s " % ("!" if open_ else "x", f.get("class", "?"),
                                             f.get("rule", "?")))
    elif r.what == "backlog":
        y = _rule(win, y, r.title)
        _, _, body = _backlog_cached(r.slug)
        for para in body.split("\n"):
            if y >= ymax:
                break
            y = _para(win, y, ymax, 2, para) if para.strip() else y + 1
    else:
        # decision / review / ready / blocked / failed. The row's own text is the point here — a
        # worker's escalation question lives in it — and the table row truncates, so it has to be
        # repeated in full before the peek tail, not replaced by it.
        y = _rule(win, y, r.task)
        y = _para(win, y, ymax, 0, r.detail, curses.A_BOLD)
        for ln in fleet_lines(r.fleet, os.path.dirname(os.path.dirname(data_dir))):
            if y < ymax:
                _addln(win, y, 0, ln, _bucket_attr("quiet")); y += 1
        report = read_report(r.fleet.report) if r.fleet and r.fleet.report else []
        if report:
            # The deliverable beats the session tail: a row that says "approve, skip or fix" is
            # asking about THIS, and the log is only how it got here.
            y = _rule(win, y, "report — p pages it in full")
            for ln in report[: max(0, ymax - y)]:
                _addln(win, y, 2, ln); y += 1     # markdown, preformatted — never rewrap it
        else:
            remaining = ymax - y
            if remaining > 0 and r.fleet:
                for ln in tl_peek(r.task, remaining).splitlines()[-remaining:]:
                    _addln(win, y, 2, ln); y += 1
    return y


# --------------------------------------------------------------------- view 2: briefing
def _draw_briefing(win, st, q, data_dir):
    h, w = win.getmaxyx()
    rows = _filtered(q.rows, st["filter"])
    _bar(win, 0, " " + _tabs(2), "%d of %d waiting " %
         ((_index_of(rows, st["cursor"]) + 1) if rows else 0, len(rows)))
    if not rows:
        _addln(win, 3, 2, "nothing is waiting on you.")
        _bar(win, h - 1, " 1 inbox   3 modal", "q quit ")
        return
    r = rows[_index_of(rows, st["cursor"])]
    y = 2

    label = {"gate": "GATE FINDINGS", "question": "OPEN QUESTION", "decision": "WORKER DECISION",
             "review": "READY TO REVIEW", "ready": "SPEC READY", "backlog": "UN-GRILLED ITEM",
             "blocked": "BLOCKED", "failed": "FAILED"}.get(r.what, r.what.upper())
    _addln(win, y, 2, "%-24s %s" % (label, r.task or r.slug),
           _bucket_attr(_WHAT_ATTR.get(r.what, "quiet"))); y += 2

    # This view exists to be READ, so nothing in it truncates — everything goes through _para.
    # ymax is the rule above the footer; _para marks the cut with '…' if a block outruns it.
    ymax = h - 2
    qq = r.question
    y = _para(win, y, ymax, 2, qq.text if qq else r.detail, curses.A_BOLD) + 1
    if qq and y < ymax:
        _addln(win, y, 2, "state %s · source %s · asked %s" % (qq.state, qq.source, qq.at),
               _bucket_attr("quiet")); y += 2

    for ln in fleet_lines(r.fleet, os.path.dirname(os.path.dirname(data_dir))):
        if y < ymax:
            _addln(win, y, 2, ln, _bucket_attr("quiet")); y += 1
    if r.fleet:
        y += 1

    if r.what == "gate" and r.fleet:
        for f in r.fleet.findings:
            if y >= ymax:
                break
            open_ = f.get("resolved") in (None, "fix")
            y = _para(win, y, ymax, 5, f.get("detail", ""),
                      curses.A_BOLD if open_ else curses.A_DIM,
                      label="%s [%s] " % ("!" if open_ else "x", f.get("rule", "?")))
        y += 1

    report = read_report(r.fleet.report) if r.fleet and r.fleet.report else []
    if report and y < ymax - 1:
        _addln(win, y, 2, "Report — p pages it in full:", _bucket_attr("quiet")); y += 1
        for ln in report[: max(0, ymax - y - 1)]:
            _addln(win, y, 5, ln); y += 1
        y += 1

    done = [x for x in (r.spec.questions if r.spec else []) if x.state != "open"]
    if done and y < ymax - 1:
        _addln(win, y, 2, "Already decided on this item:", _bucket_attr("quiet")); y += 1
        # A well-grilled item can carry a dozen answers, each two or three lines once wrapped —
        # enough to fill the screen and push the backlog context off it. Prior answers are context
        # for the decision, not the decision, so they yield: cap them and say how many were held
        # back, keeping the last few lines for what the backlog actually asked for.
        stop = max(y, ymax - 4)
        shown = 0
        for x in done:
            # all-or-nothing: half an answer ending in '…' reads like the list ended, so an entry
            # that doesn't fit entirely is held back and counted instead
            if y + len(_wrap(x.text, max(8, w - 11))) > stop:
                break
            y = _para(win, y, stop, 5, x.text, label="%-5s" % x.qid)
            shown += 1
        if shown < len(done) and y < ymax:
            _addln(win, y, 5, "+%d more — 3 modal, :q %s shows them all"
                   % (len(done) - shown, r.slug or ""), _bucket_attr("quiet")); y += 1
        y += 1

    if r.slug and y < ymax - 1:
        _, title, body = _backlog_cached(r.slug)
        if title or body:
            _addln(win, y, 2, "Backlog said:", _bucket_attr("quiet")); y += 1
            y = _para(win, y, ymax, 5, title + (" — " + body if body else ""))

    _addln(win, h - 2, 0, "─" * (w - 1), _bucket_attr("quiet"))
    if st["notice"]:
        _bar(win, h - 1, " " + st["notice"], " (any key) ")
    elif r.what == "question":
        _bar(win, h - 1, " d decided   l leaning   s spike   x reject item   e edit",
             "n next   q quit ")
    elif r.what == "backlog":
        _bar(win, h - 1, " g grill   r run (grill+dispatch)   e edit   x drop", "n next   q quit ")
    elif r.what == "review":
        _bar(win, h - 1, " p read the report   g approve/deliver   e edit   r run",
             "n next   q quit ")
    elif r.what == "retire":
        _bar(win, h - 1, " t retire (frees the worktree)   p read the report", "n next   q quit ")
    elif r.what == "working":
        _bar(win, h - 1, " p follow its log (tail -f)   3 fleet   e edit", "n next   q quit ")
    else:
        _bar(win, h - 1, " r run   g gate   p peek   e edit   x reject", "n next   q quit ")


# ------------------------------------------------------------------------ view 3: modal
def modal_table(view, arg, q, data_dir, lead_dir):
    """(breadcrumb, header, [(line, target)]) for one `:` view. One renderer, so a new view later
    costs one entry here.

    `target` is None (nothing to act on) or a Target — and it is what makes view 3 more than a
    read-only table: `:q <slug>` lists EVERY question, including the ones the grill already
    inferred, so d/l/s can correct one. Those never appear in the inbox (they aren't waiting on
    anyone), which is exactly why this is the place to reach them."""
    if view == "backlog":
        rows = [("%-16s %-11s %-5s %s" % (slug[:16], stage[:11],
                                          ("%d/%d" % (o, t)) if t else "-", title[:36]),
                 Target(tid or slug, "", "", slug, title))
                for slug, title, tid, stage, o, t in q.items]
        return "techlead > backlog", "%-16s %-11s %-5s %s" % ("SLUG", "STAGE", "OPEN", "TITLE"), rows
    if view == "q":
        tid = "tl-" + slugify(arg) if arg else ""
        spec = read_spec(os.path.join(data_dir, tid, "spec.md")) if tid else None
        if spec is None:
            return "techlead > q > %s" % arg, "", [("no spec for '%s' — grill it first" % arg, None)]
        rows = [("%-5s %-9s %-10s %s" % (x.qid, x.state, x.source, x.text),
                 Target(tid, x.qid, seed_for(x), arg, x.text))
                for x in spec.questions]
        return ("techlead > q > %s" % arg, "%-5s %-9s %-10s %s" % ("QID", "STATE", "SOURCE", "ASKED"),
                rows)
    if view == "findings":
        tid = arg if _ID_RE.match(arg or "") else ""
        fs = read_findings(os.path.join(data_dir, tid, "findings.json")) if tid else []
        rows = [("%-2s %-10s %-18s %s" % ("!" if f.get("resolved") in (None, "fix") else "x",
                                          f.get("class", "?"), f.get("rule", "?"),
                                          f.get("detail", "")),
                 Target(tid, "", "", "", f.get("detail", ""))) for f in fs]
        return ("techlead > findings > %s" % tid,
                "%-2s %-10s %-18s %s" % ("", "CLASS", "RULE", "DETAIL"),
                rows or [("no findings for '%s'" % tid, None)])
    if view == "bank":
        entries = read_bank(os.path.join(lead_dir, "questions.md"))
        rows = [("%-5s %s" % (hits, question), None) for question, hits, _scar in entries]
        return ("techlead > bank", "%-5s %s" % ("HITS", "QUESTION"),
                rows or [("lead/questions.md is empty (#49) — the bank is the asset (§2.6)", None)])
    # fleet (default)
    rows = []
    fmt = "%-22s %-7s %-14s %-25s %s"
    def _state_col(r):
        return ("%s %s" % (r.state, age(time.time() - r.started)))[:14] if r.started else r.state[:14]
    for r in sorted(q.quiet, key=lambda r: r.id):
        rows.append((fmt % (r.id[:22], r.kind[:7], _state_col(r), (r.branch or "-")[:25],
                            _liveness(r)),
                     Target(r.id, "", "", "", "%s on %s — %s" % (r.kind, r.branch or "?", r.project))))
    for r in q.rows:
        if r.fleet:
            f = r.fleet
            rows.insert(0, (fmt % (f.id[:22], f.kind[:7], _state_col(f), (f.branch or "-")[:25],
                                   f.waiting_on or _liveness(f)),
                            Target(f.id, "", "", r.slug, r.detail)))
    return ("techlead > fleet",
            fmt % ("TASK", "KIND", "STATE", "BRANCH", "WAITING ON"),
            rows or [("no active tasks — the fleet is idle.", None)])


def _draw_modal(win, st, q, data_dir):
    h, w = win.getmaxyx()
    crumb, header, rows = _modal_view(st, q, data_dir)
    _bar(win, 0, " " + _tabs(3), ":cmd  /filter  esc back ")
    _addln(win, 1, 0, " " + crumb, _bucket_attr("quiet"))
    if header:
        _addln(win, 2, 0, " " + header, curses.A_UNDERLINE)
    st["msel"] = max(0, min(st["msel"], len(rows) - 1)) if rows else 0

    # Reserve the bottom for the selected row IN FULL. The table above truncates each row to one
    # line — that is what makes it scannable — so this pane is the only place a long question is
    # actually readable here, and it is why the command hints get one line instead of two.
    detail_h = 5
    body_h = max(3, h - 6 - detail_h)
    top = max(0, st["msel"] - body_h + 1) if st["msel"] >= body_h else 0
    y = 3
    for i in range(top, min(len(rows), top + body_h)):
        attr = curses.A_REVERSE if i == st["msel"] else (
            0 if rows[i][1] else _bucket_attr("quiet", bold=False))
        _addln(win, y, 0, (" " + rows[i][0]).ljust(w), attr)
        y += 1

    y = h - detail_h - 2
    sel_t = rows[st["msel"]][1] if rows and 0 <= st["msel"] < len(rows) else None
    y = _rule(win, y, ("%s · %s" % (sel_t.task, sel_t.qid)) if sel_t and sel_t.qid
              else (sel_t.task if sel_t else ""))
    if sel_t and sel_t.text:
        y = _para(win, y, h - 2, 1, sel_t.text)
    _addln(win, h - 2, 1, ":backlog  :q <slug>  :fleet  :findings <id>  :bank  ·  / filters",
           _bucket_attr("quiet"))
    if st["notice"]:
        _bar(win, h - 1, " " + st["notice"], " (any key) ")
    else:
        _bar(win, h - 1, " : command   / filter   enter briefing   d/l/s answer",
             "%d rows   q quit " % len(rows))


# ------------------------------------------------------------------------------ helpers
def _wrap(s, width):
    out, line = [], ""
    for word in (s or "").split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = word
        else:
            line = (line + " " + word).strip()
    if line:
        out.append(line)
    return out or [""]


def _para(win, y, ymax, x, text, attr=0, label=""):
    """Draw owner prose wrapped to the window, hanging-indented under `label`. Returns the new y.

    Questions, answers, findings and backlog bodies are written by a person and are routinely
    longer than a line — truncating them at the window edge is the one thing that makes a detail
    pane useless. If it still doesn't fit the space available, the last line drawn ends in '…' so
    the cut is visible rather than silent."""
    _h, w = win.getmaxyx()
    ind = x + len(label)
    lines = _wrap(text, max(8, w - ind - 1))
    for i, ln in enumerate(lines):
        if y >= ymax:
            break
        if i == 0 and label:
            _addln(win, y, x, label, _bucket_attr("quiet"))
        clipped = i < len(lines) - 1 and y + 1 >= ymax
        _addln(win, y, ind, (ln + " …") if clipped else ln, attr)
        y += 1
    return y


def _rule(win, y, title=""):
    """A labelled section rule, always full width whatever the terminal is."""
    _h, w = win.getmaxyx()
    head = ("── %s " % title) if title else "──"
    _addln(win, y, 0, head + "─" * max(0, w - len(head) - 1), _bucket_attr("quiet"))
    return y + 1


def _filtered(rows, needle):
    if not needle:
        return rows
    n = needle.lower()
    return [r for r in rows
            if n in (r.task + " " + r.slug + " " + r.what + " " + r.detail).lower()]


def _index_of(rows, key):
    for i, r in enumerate(rows):
        if r.key == key:
            return i
    return 0


_BACKLOG_CACHE = {}


def _backlog_cached(slug):
    """tl-backlog show, memoised — the queue recomputes every 2s and the body only changes when
    the owner edits it (which clears this)."""
    if slug not in _BACKLOG_CACHE:
        _BACKLOG_CACHE[slug] = tl_backlog_show(slug)
    return _BACKLOG_CACHE[slug]


def worktree_lines(f, project_root=""):
    """['worktree  <path>', 'branch  <b>  base <sha>  N ahead · dirty'] for a dispatched row.

    A task's worktree and branch are what `g` is about to merge, and with several workers running
    they are the only thing telling two rows apart at a glance. `ahead`/`dirty` need git, so this
    is called for the SELECTED row only — never for every row on the refresh timer."""
    if not f or not (f.worktree or f.branch):
        return []
    # Show it relative to the project. Anchor on "/.techlead/" rather than a prefix match: the meta
    # holds the path git canonicalised at spawn (`pwd -P`), which on macOS is /private/var/... while
    # the same directory reached through $PWD is /var/... — a prefix test misses and you get an
    # absolute path wide enough to be clipped.
    path = f.worktree
    if "/.techlead/" in path:
        path = path[path.index("/.techlead/") + 1:]
    elif project_root and path.startswith(project_root + "/"):
        path = path[len(project_root) + 1:]
    out = ["worktree  " + (path or "—")]
    tail = "branch    %s" % (f.branch or "—")
    if f.base:
        tail += "   base %s" % f.base[:7]
    if f.worktree and os.path.isdir(f.worktree):
        n = _run_capture(["git", "-C", f.worktree, "rev-list", "--count",
                          "%s..HEAD" % f.base]).strip() if f.base else ""
        if n.isdigit() and int(n):
            tail += "   %s ahead" % n
        if _run_capture(["git", "-C", f.worktree, "status", "--porcelain"]).strip():
            tail += "   · uncommitted"
    else:
        tail += "   · worktree gone"
    return out + [tail]


def fleet_lines(f, project_root=""):
    """What a dispatched row shows about itself: where it is running, and whether it is alive.
    Once a task is working it recedes out of the priority list, so this is the whole story."""
    out = worktree_lines(f, project_root)
    if f is not None and f.started:
        out.append("started   %s ago   ·   %s" % (age(time.time() - f.started), _liveness(f)))
    return out


def _suspend(win, fn):
    """The curses handoff: release the terminal, run fn full-screen, restore + repaint."""
    curses.def_prog_mode()
    curses.endwin()
    try:
        fn()
    except KeyboardInterrupt:
        pass                      # ctrl-c is how you leave a follow; it is not an error
    finally:
        curses.reset_prog_mode()
        # redrawwin, not just refresh: the shelled command wrote all over the terminal, but curses
        # still believes the screen holds what IT last drew, so a plain refresh re-emits only the
        # cells that differ from that stale model — leaving the command's output showing through.
        win.redrawwin()
        win.refresh()


def _shell_out(win, argv):
    """Hand the terminal to a real tl-* command, then RETURN ITS EXIT CODE.

    Throwing the status away made every failure silent: the command printed its error, the pause
    scrolled it out of mind, and the TUI came back looking untouched — indistinguishable from
    nothing having happened. A grill with no TL_GRILL_CMD exits 1 before doing any work, and that
    looked exactly like a grill that ran and found nothing."""
    rc = {}
    def go():
        try:
            rc["code"] = subprocess.call(argv)
        except OSError as e:
            rc["code"] = 127
            print("\ntl-top: could not run %s (%s)" % (argv[0], e))
        code = rc.get("code", 1)
        banner = "" if code == 0 else ("\n*** %s exited %d — the error is above ***"
                                       % (os.path.basename(argv[0]), code))
        try:
            input("%s\n[enter to return] " % banner)
        except EOFError:
            pass
    _suspend(win, go)
    return rc.get("code", 1)


def _ran(argv, rc, ok):
    """The notice for a shelled command, so its outcome survives the return to the TUI."""
    name = os.path.basename(argv[0]).replace(".sh", "")
    return ok if rc == 0 else "%s exited %d — nothing changed (its error was on the shell)" % (name, rc)


def _page_file(win, path):
    """Read a deliverable full-screen, through TL_MD_VIEWER (else $PAGER, else less).

    Reports are markdown, and a pager shows them as plain text. TL_MD_VIEWER is a separate knob
    from $PAGER on purpose: $PAGER also handles the raw session log, where a markdown renderer
    would be wrong. No dependency is adopted (§5) — the viewer is whatever the operator names, and
    the default keeps working with nothing installed:

        export TL_MD_VIEWER="glow -w 100"     # or bat, mdcat, rich, …
    """
    def go():
        viewer = os.environ.get("TL_MD_VIEWER") or os.environ.get("PAGER") or "less"
        try:
            subprocess.call(shlex.split(viewer) + [path])
            if os.environ.get("TL_MD_VIEWER"):
                # a renderer prints and exits, unlike a pager that waits — so hold the output
                try:
                    input("\n[enter to return] ")
                except EOFError:
                    pass
        except OSError:
            with open(path) as f:
                sys.stdout.write(f.read())
            try:
                input("\n[enter to return] ")
            except EOFError:
                pass
    _suspend(win, go)


def _follow(win, tid):
    """tail -f the worker's session log until you interrupt — `p` on a running task used to show a
    frozen snapshot, so watching meant pressing it again and again."""
    if not _ID_RE.match(tid):
        return

    def go():
        print("── following %s — ctrl-c to return ──" % tid)
        try:
            subprocess.call([os.path.join(BIN, "tl-peek.sh"), tid, "200", "--follow"])
        except KeyboardInterrupt:
            pass                                   # ctrl-c is how you leave; it is not an error
    _suspend(win, go)


def _peek_fullscreen(win, tid):
    if not _ID_RE.match(tid):
        return

    def go():
        p1 = subprocess.Popen([os.path.join(BIN, "tl-peek.sh"), tid, "500"], stdout=subprocess.PIPE)
        try:
            pager = subprocess.Popen(shlex.split(os.environ.get("PAGER") or "less"), stdin=p1.stdout)
            p1.stdout.close()
            pager.wait()
        except OSError:                        # no pager on PATH — dump + wait
            sys.stdout.write(p1.stdout.read().decode("utf-8", "replace"))
            try:
                input("\n[enter to return] ")
            except EOFError:
                pass
        p1.wait()
    _suspend(win, go)


def _edit_file(win, path, line=0):
    """$EDITOR, full-screen. The editor mutates the file; tl-top still never writes one itself."""
    if not path:
        return
    ed = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    argv = shlex.split(ed)
    if line and os.path.basename(argv[0]) in _EDITORS_WITH_PLUS:
        argv.append("+%d" % line)
    argv.append(path)
    _suspend(win, lambda: subprocess.call(argv))
    _BACKLOG_CACHE.clear()


def _confirm(win, msg):
    """A deliberate two-step for consequences: press the key, then confirm. Never a bare keypress,
    and never a bulk 'approve all' — the real approve/skip/fix happens inside the shelled command."""
    h, w = win.getmaxyx()
    _addln(win, h - 1, 0, (" " + msg + "   [y/N] ").ljust(w), curses.A_REVERSE | curses.A_BOLD)
    win.noutrefresh()
    curses.doupdate()
    win.timeout(-1)                            # block for the decision
    ch = win.getch()
    win.timeout(_interval_ms())
    return ch in (ord("y"), ord("Y"))


def _prompt(win, label, seed="", rows=3):
    """The shared editable prompt (curses.textpad.Textbox: ^A/^E/^K/^U, arrows, wrapping).
    Returns the text collapsed to ONE line, or None if cancelled with ESC.

    Newlines are collapsed on purpose: tl-spec.sh stores each question as one pipe-encoded line,
    so a literal newline would split the record. See _sanitise for the pipe."""
    h, w = win.getmaxyx()
    rows = max(1, min(rows, h - 3))
    y0 = h - rows - 1
    _bar(win, y0 - 1, " " + label, " enter commit · esc cancel · ^A/^E/^K edit ")
    for y in range(y0, y0 + rows):
        _addln(win, y, 0, " " * (w - 1))
    win.noutrefresh()
    curses.doupdate()

    ed = curses.newwin(rows, w - 2, y0, 1)
    ed.keypad(True)
    if seed:
        try:
            ed.addstr(0, 0, seed[: rows * (w - 3)])
        except curses.error:
            pass
    box = curses.textpad.Textbox(ed, insert_mode=True)
    cancelled = []

    def validate(ch):
        if ch in (10, 13, curses.KEY_ENTER):
            return 7                                    # Ctrl-G — terminate the edit
        if ch == 27:                                    # ESC — cancel
            cancelled.append(True)
            return 7
        if ch in (curses.KEY_BACKSPACE, 127, 8):
            return 8                                    # make macOS delete behave
        return ch

    curses.curs_set(1)
    try:
        text = box.edit(validate)
    finally:
        curses.curs_set(0)
    if cancelled:
        return None
    return " ".join(text.split())


def _sanitise(text):
    """spec.md question lines are pipe-encoded (tl-spec.sh qset), so a '|' in the answer would
    truncate it on the next read. Replace rather than refuse mid-flow, and say so.
    tl: the real fix is escaping in tl-spec.sh's encoder — that changes a durable file format,
        so it belongs in a grill, not here."""
    if "|" in text:
        return text.replace("|", "/"), "'|' replaced with '/' — spec.md questions are pipe-encoded"
    return text, ""


def _help(win):
    lines = [
        "  1 / 2 / 3 / tab   switch view (inbox · briefing · modal)",
        "  j k ↑ ↓           move the cursor (shared by all three views)",
        "  d l s             answer decided / leaning / spike  → tl-grill answer",
        "  x                 reject the item                   → tl-grill reject",
        "  e                 edit the backlog item or the spec → $EDITOR",
        "  t                 retire a signed-off task          → tl-teardown (confirm)",
        "  n                 next waiting item",
        "  r                 run / resume the pipeline         → tl-run   (confirm)",
        "  g                 grill an un-grilled backlog item  → tl-grill  (confirm)",
        "                    …or resolve the delivery gate     → tl-deliver (confirm)",
        "  p                 read the report · follow a running worker · peek",
        "  H                 draft a test harness              → tl-scaffold-test (confirm)",
        "  / :               filter · command (view 3)",
        "  ? q               this help · quit",
        "",
        "  tl-top renders, never mutates: every consequence runs the real tl-* command.",
    ]
    h, w = win.getmaxyx()
    win.erase()
    _bar(win, 0, " tl-top — keys", " any key to return ")
    for i, ln in enumerate(lines):
        _addln(win, 2 + i, 0, ln)
    win.noutrefresh()
    curses.doupdate()
    win.timeout(-1)
    win.getch()
    win.timeout(_interval_ms())


# --------------------------------------------------------------------------------- loop
def _answer(win, target, state_word, context=""):
    """d/l/s — prompt (seeded per seed_for), then hand the whole thing to tl-grill.
    tl-top never writes spec.md (§3.5): the command owns the write, so its validation and its
    correction log (inferred-outcomes.tsv) still fire. Captured rather than full-screen because
    it is one non-interactive line of output — the decision path is unchanged either way."""
    if not target or not target.qid:
        return "d/l/s answers a grill question — this row isn't one (try 3 modal → :q <slug>)"
    label = "answer %s [%s]" % (target.qid, state_word)
    if context:
        label += " · " + context
    text = _prompt(win, label, target.seed)
    if text is None:
        return ""
    if not text:
        return "no answer written — nothing recorded"
    text, notice = _sanitise(text)
    rc, out = _run_cmd([os.path.join(BIN, "tl-grill.sh"), "answer",
                        target.task, target.qid, state_word, text])
    if rc != 0:
        return "tl-grill refused: " + (out or "rc=%d" % rc)
    return (notice + " · " if notice else "") + (out or "%s → %s" % (target.qid, state_word))


def _reject(win, target):
    if not target:
        return ""
    if not target.task.startswith("tl-"):
        return "'%s' has no spec yet — grill it before rejecting" % target.slug
    reason = _prompt(win, "reject %s — why?" % target.task, "", rows=2)
    if reason is None:
        return ""
    if not reason:
        return "reject needs a reason (D10: it is a terminal decision)"
    reason, _ = _sanitise(reason)
    rc, out = _run_cmd([os.path.join(BIN, "tl-grill.sh"), "reject", target.task, reason])
    return out if rc == 0 else "tl-grill refused: " + (out or "rc=%d" % rc)


def _command(win, st):
    cmd = _prompt(win, ":", "", rows=1)
    if not cmd:
        return ""
    parts = cmd.split()
    verb, arg = parts[0].lstrip(":"), (parts[1] if len(parts) > 1 else "")
    if verb in ("backlog", "fleet", "bank", "q", "findings"):
        st["modal"] = (verb, arg)
        st["msel"] = 0
        return ""
    return "unknown command ':%s' — try :backlog :q <slug> :fleet :findings <id> :bank" % verb


def _target_path(target, data_dir):
    """What `e` opens: the backlog file at this item's heading, or the spec it has grown into."""
    if not target.task.startswith("tl-"):
        line, _, _ = _backlog_cached(target.slug)
        return _backlog_path(), line
    return os.path.join(data_dir, target.task, "spec.md"), 0


def _modal_view(st, q, data_dir):
    """The current `:` table, filtered — one place, so the drawing and the keys can't disagree
    about which row st['msel'] points at."""
    crumb, header, rows = modal_table(*st["modal"], q, data_dir, _lead_path())
    return crumb, header, [r for r in rows
                           if not st["filter"] or st["filter"].lower() in r[0].lower()]


def _msel_for(st, q, data_dir, sel):
    """Landing in view 3 from the cursor: select the row that is the same decision, if present."""
    for i, (_line, t) in enumerate(_modal_view(st, q, data_dir)[2]):
        if t and t.task in (sel.task, sel.slug) and t.qid == sel.qid:
            return i
    return 0


def _current_target(st, q, rows, data_dir):
    """The one thing every action key acts on — resolved from whichever view has the focus."""
    if st["view"] == 3:
        mrows = _modal_view(st, q, data_dir)[2]
        if mrows and 0 <= st["msel"] < len(mrows):
            return mrows[st["msel"]][1]
        return None
    return rows[_index_of(rows, st["cursor"])].target if rows else None


def _loop(win):
    curses.curs_set(0)
    try:
        curses.set_escdelay(25)         # ESC should cancel now, not in a second (py3.9+)
    except AttributeError:
        pass
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(CP_LOUD, curses.COLOR_RED, -1)
        curses.init_pair(CP_STUCK, curses.COLOR_YELLOW, -1)
        curses.init_pair(CP_READY, curses.COLOR_GREEN, -1)
        curses.init_pair(CP_QUIET, curses.COLOR_CYAN, -1)
    win.timeout(_interval_ms())
    state_dir, data_dir = _state_paths()

    def recompute():
        return build_queue_model(state_dir, data_dir, tl_state, tl_backlog_list())

    q = recompute()
    st = {"view": 1, "cursor": q.rows[0].key if q.rows else None,
          "modal": ("fleet", ""), "msel": 0, "filter": "", "notice": ""}

    while True:
        rows = _filtered(q.rows, st["filter"])
        if rows and st["cursor"] not in {r.key for r in rows}:
            st["cursor"] = rows[0].key
        win.erase()
        if st["view"] == 1:
            _draw_inbox(win, st, q, data_dir)
        elif st["view"] == 2:
            _draw_briefing(win, st, q, data_dir)
        else:
            _draw_modal(win, st, q, data_dir)
        win.noutrefresh()
        curses.doupdate()

        try:
            ch = win.getch()
        except KeyboardInterrupt:
            return
        if ch != -1:
            # A keypress clears the last result and STILL acts. Swallowing it (so the message was
            # "acknowledged") costs a key exactly where the rhythm is d, type, enter, d, type… —
            # you answer, the row vanishes, the next one is already selected, and the d meant for
            # it disappears into dismissing a message you had already read. The notice stays put
            # across refresh ticks, so nothing is missed by not consuming a key for it.
            st["notice"] = ""

        sel = rows[_index_of(rows, st["cursor"])] if rows else None
        target = _current_target(st, q, rows, data_dir)

        if ch == -1:
            q = recompute()
        elif ch in (ord("q"), ord("Q")):
            return
        elif ch in (ord("1"), ord("2"), ord("3")):
            was, st["view"] = st["view"], ch - ord("0")
            if st["view"] == 3 and was != 3 and sel:
                # the cursor carries: land on the table the selected decision lives in
                st["modal"] = (("q", sel.slug) if sel.what == "question"
                               else ("backlog", "") if sel.what == "backlog" else ("fleet", ""))
                st["msel"] = _msel_for(st, q, data_dir, sel)
        elif ch == ord("\t"):
            st["view"] = st["view"] % 3 + 1
        elif ch in (curses.KEY_DOWN, ord("j")):
            if st["view"] == 3:
                st["msel"] += 1
            elif rows:
                st["cursor"] = rows[min(_index_of(rows, st["cursor"]) + 1, len(rows) - 1)].key
        elif ch in (curses.KEY_UP, ord("k")):
            if st["view"] == 3:
                st["msel"] = max(0, st["msel"] - 1)
            elif rows:
                st["cursor"] = rows[max(_index_of(rows, st["cursor"]) - 1, 0)].key
        elif ch == ord("n") and rows:
            st["cursor"] = rows[(_index_of(rows, st["cursor"]) + 1) % len(rows)].key
        elif ch in (curses.KEY_ENTER, 10, 13):
            if st["view"] == 3:
                # only a row that is actually waiting on you has a briefing to open
                want = "question|%s|%s" % (target.task, target.qid) if target else ""
                if want in {r.key for r in q.rows}:
                    st["cursor"], st["view"] = want, 2
                elif target and any(r.task == target.task for r in q.rows):
                    st["cursor"] = next(r.key for r in q.rows if r.task == target.task)
                    st["view"] = 2
                else:
                    st["notice"] = "nothing is waiting on that row — d/l/s still works on it"
            else:
                st["view"] = 2 if st["view"] == 1 else 1
        elif ch == ord("?"):
            _help(win)
        elif ch == ord("/"):
            # Deliberately NOT seeded with the current filter: `/` starts a fresh one, so enter on
            # an empty prompt clears it and a new term replaces rather than concatenates. Seeding
            # made re-filtering require clearing the old text first, and `/` then enter a no-op.
            f = _prompt(win, "/", "", rows=1)
            st["filter"] = f if f is not None else st["filter"]
        elif ch == ord(":"):
            st["view"] = 3
            st["notice"] = _command(win, st)
        elif ch in _ANSWER_KEYS:
            ctx = (sel.detail if sel and st["view"] != 3 else "")
            st["notice"] = _answer(win, target, _ANSWER_KEYS[ch], ctx)
            q = recompute()
        elif ch == ord("x") and target:
            st["notice"] = _reject(win, target)
            q = recompute()
        elif ch == ord("e") and target:
            path, line = _target_path(target, data_dir)
            _edit_file(win, path, line)
            q = recompute()
        elif ch == ord("H"):
            name = current_project()
            if not name:
                st["notice"] = "no single registered project here — run tl-scaffold-test by hand"
            elif _confirm(win, "Draft a test harness: tl-scaffold-test %s  (you review + commit it, "
                               "then tl-baseline promotes the project to `ready`)" % name):
                argv = [os.path.join(BIN, "tl-scaffold-test.sh"), name]
                st["notice"] = _ran(argv, _shell_out(win, argv),
                                    "drafted a harness — review it, commit it, then: tl-baseline %s"
                                    % name)
            q = recompute()
        elif ch == ord("t") and target and target.task.startswith("tl-"):
            if _confirm(win, "Retire: tl-teardown %s  (releases its worktree; the report is kept)"
                        % target.task):
                argv = [os.path.join(BIN, "tl-teardown.sh"), target.task]
                st["notice"] = _ran(argv, _shell_out(win, argv),
                                    "retired %s — its worktree is released" % target.task)
            q = recompute()
        elif ch == ord("p") and target and target.task.startswith("tl-"):
            row = next((r for r in q.rows if r.task == target.task and r.fleet), None)
            if row and row.what == "working":
                _follow(win, target.task)              # watch it work, rather than snapshot it
            elif row and row.fleet.report and os.path.isfile(row.fleet.report):
                _page_file(win, row.fleet.report)      # the deliverable beats the session tail
            else:
                _peek_fullscreen(win, target.task)
        elif ch == ord("r") and target:
            slug = target.slug or (target.task[3:] if target.task.startswith("tl-") else target.task)
            if _confirm(win, "Run pipeline: tl-run %s  (its own approve/reject prompts)" % slug):
                argv = [os.path.join(BIN, "tl-run.sh"), slug]
                rc = _shell_out(win, argv)
                q = recompute()
                started = next((r for r in q.rows if r.what == "working" and r.slug == slug), None)
                if rc == 0 and started:
                    # it dispatched a worker — land in :fleet on it, which is where you watch
                    st["view"], st["modal"], st["msel"] = 3, ("fleet", ""), 0
                    st["cursor"] = started.key
                    st["msel"] = _msel_for(st, q, data_dir, started)
                st["notice"] = _ran(argv, rc, "dispatched '%s' — following it here; p tails its log"
                                    % slug if started else
                                    "tl-run '%s' finished — the list shows where it stopped" % slug)
            q = recompute()
        elif ch == ord("g") and target:
            if not target.task.startswith("tl-"):
                # never grilled: run the grill ALONE, so the questions land here to answer. `r` is
                # still the whole pipeline (grill → brief → spawn), which dispatches a worker.
                if _confirm(win, "Grill '%s': tl-grill %s  (one model call; no worker is dispatched)"
                            % (target.slug, target.slug)):
                    argv = [os.path.join(BIN, "tl-grill.sh"), target.slug]
                    st["notice"] = _ran(argv, _shell_out(win, argv),
                                        "grilled '%s' — its questions are in the list" % target.slug)
            else:
                # a `plan` has no gate — its terminal step is the owner approving the report, which
                # is tl-approve. Mirrors tl-run's own kind test, so the TUI and the CLI agree.
                row = next((r for r in q.rows if r.task == target.task and r.fleet), None)
                kind = row.fleet.kind if row else "change"
                if kind == "change":
                    prompt, argv, ok = ("Resolve gate: tl-deliver %s  (approve/skip/fix per finding)",
                                        [os.path.join(BIN, "tl-deliver.sh"), target.task],
                                        "delivered %s" % target.task)
                else:
                    prompt, argv, ok = ("Review the report: tl-approve %s  (approve / skip / fix)",
                                        [os.path.join(BIN, "tl-approve.sh"), target.task],
                                        "recorded your decision on %s" % target.task)
                if _confirm(win, prompt % target.task):
                    st["notice"] = _ran(argv, _shell_out(win, argv), ok)
            q = recompute()


def run():
    _guard()
    curses.wrapper(_loop)


if __name__ == "__main__":
    if "--selftest" in sys.argv[1:]:
        _selftest()
    else:
        run()
